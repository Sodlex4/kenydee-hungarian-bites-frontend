# WhatsApp number for checkout (international format, no + or spaces)
VITE_WHATSAPP_NUMBER=your_whatsapp_number_here

# Contact email shown in footer and legal pages
VITE_CONTACT_EMAIL=your@email.com

# Google Analytics measurement ID (leave empty to disable tracking)
VITE_GA_MEASUREMENT_ID=

# Canonical site URL for meta tags and SEO
VITE_SITE_URL=https://your-site.com

# Admin panel password (temporary, will be replaced with JWT auth)
VITE_ADMIN_PASSWORD=change_this_password

# Social media URLs
VITE_FACEBOOK_URL=https://facebook.com/your-page
VITE_INSTAGRAM_URL=https://instagram.com/your-profile
